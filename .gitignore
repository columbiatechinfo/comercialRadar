dados/modelos/

# Cache de malha das UFs (0,3 MB, se rebaixa do IBGE sozinho)
malhas/

# A área de trabalho mora na tabela area_trabalho, não em arquivo
areas/

# Radar Coletivo — saidas de trabalho (CSV do municipio, xlsx e RCC)
coletivas/

# Cache de malhas/CNEFE do IBGE (135 MB, reconstruivel sob demanda)
