rebusca_resultados.json

# Config local do Claude Code
.claude/

# Pesos de modelos (baixados on-demand)
*.pt

# Galerias/artefatos gerados de telhados (base64 pesado, regeneráveis)
exemplos/_telhados_*.html

# Bases externas baixadas (pesadas, regeneráveis)
dados_externos/

