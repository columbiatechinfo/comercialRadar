# ComercialRadar — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com suas chaves reais.
# O `.env` está no .gitignore e NUNCA deve ser commitado.

# Chave da API Webshare (Dashboard → API → Keys)
# Usada pelo proxy_pool.py para baixar a lista de IPs estáticos residenciais.
WEBSHARE_API_KEY=cole_sua_chave_aqui

# PostgreSQL local (banco compartilhado "comercialradar")
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=comercialradar
DATABASE_URL="postgresql://postgres:senha_url_encoded@localhost:5432/comercialradar?schema=public"

# OpenAI (decisor de equivalência de vizinhos)
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini

# Gemini com billing (localizador via Google Search grounding)
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform (Places Nearby/Details) — usada pelo minerar_area.py
MAPS_API_KEY=cole_sua_chave_aqui
