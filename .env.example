# ComercialRadar — variáveis de ambiente
#
# Copie para `.env` e preencha com os valores reais. O `.env` está no
# `.gitignore` e NUNCA é commitado — este arquivo existe para documentar QUAIS
# segredos o sistema precisa, sem carregar nenhum.
#
# Conferido contra o código em 12/08/2026: toda variável aqui é lida por algum
# módulo, e todo módulo lê alguma daqui.

# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=comercialradar
# Senha com '@' precisa ir percent-encoded aqui: '@' vira %40
DATABASE_URL=

# ─── Google Maps Platform ─────────────────────────────────────────────────
# São TRÊS chaves diferentes de propósito, cada uma com a sua restrição no
# console. Uma chave só, sem restrição, é a que vaza e dá prejuízo.
#
# A separação não é preciosismo: o tipo de restrição que protege uma QUEBRA a
# outra. Chave de navegador se restringe por referrer HTTP; chave de servidor,
# por IP. Aplicar restrição de referrer numa chamada feita pelo Python devolve
# REQUEST_DENIED, porque requisição de servidor não manda referrer.
#
# MAPS_JS_KEY      Maps JavaScript API do painel — restrinja por REFERRER:
#                  http://localhost:8765/*  http://127.0.0.1:8765/*
# GOOGLE_TILES_KEY base de satélite do mapa — mesma restrição de referrer
#                  (hoje costuma ser a mesma chave da MAPS_JS_KEY)
# MAPS_SERVER_KEY  chamadas feitas pelo PYTHON: metadados e imagem do Street
#                  View, que são gratuitos — restrinja por IP público de saída
#                  e libere só a Street View Static API
# MAPS_API_KEY     INTERRUPTOR do motor Places, que é PAGO. Deixe vazia para
#                  manter a mineração paga desligada — não a preencha só para
#                  usar um endpoint grátis
MAPS_JS_KEY=
GOOGLE_TILES_KEY=
MAPS_SERVER_KEY=
MAPS_API_KEY=
# Map ID do estilo (não é segredo; é identificador público do mapa)
GOOGLE_MAP_ID=

# ─── Modelos de linguagem ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama local — sem chave. É endereço, não segredo.
OLLAMA_URL=http://100.115.117.49:11434

# ─── Busca web ────────────────────────────────────────────────────────────
# Instâncias em ordem de preferência, separadas por vírgula. A primeira que
# responder atende; as seguintes são reserva.
SEARXNG_URL=http://100.115.117.49:8888,http://localhost:8888

# ─── Proxies ──────────────────────────────────────────────────────────────
# Webshare → Dashboard → API → Keys. Usada pelo proxy_pool.py para baixar a
# lista de IPs residenciais estáticos.
WEBSHARE_API_KEY=
