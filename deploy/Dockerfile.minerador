# O minerador do Radar Comercial — dez Chromium e nenhuma porta publicada.
#
# POR QUE UMA IMAGEM SEPARADA DA API
#
# Esta pesa perto de 2 GB: são os navegadores do Playwright mais as bibliotecas
# de sistema que um Chromium exige. A API pesa uma fração disso e sobe em
# segundos. Juntá-las faria toda subida do painel arrastar dois gigabytes que o
# painel não usa — e, pior, obrigaria a API a abrir mão de `read_only`, porque
# navegador escreve perfil, cache e crash dump em disco o tempo todo.
#
# A imagem oficial do Playwright já traz os navegadores e as dependências de
# sistema na versão certa. Instalar Chromium à mão sobre um `slim` é onde nasce
# o "funciona aqui e não lá": a versão do Playwright e a do navegador têm de
# casar, e o `playwright install` sozinho não instala as libs do sistema.
# A TAG TEM DE CASAR COM `playwright==` DO requirements.txt. Hoje 1.62.0
# — subiu de 1.60.0 em 02/09/2026 junto com a entrada do `scrapling`, que
# traz o playwright novo consigo. As duas sobem juntas ou nenhuma. Se uma
# das duas subir sozinha, o Playwright procura um navegador que a imagem não
# tem, e o erro fala de executável ausente em vez de falar de versão.
FROM mcr.microsoft.com/playwright/python:v1.62.0-jammy

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# O NAVEGADOR DO PLAYWRIGHT DO PIP, pelo mesmo motivo do npm mais abaixo.
#
# A imagem `playwright/python:v1.60.0-jammy` ja traz os navegadores da versao
# 1.60.0. So que o `pip install -r requirements.txt` roda DEPOIS do `FROM` e
# pode instalar outra versao do pacote — e cada versao procura o navegador numa
# pasta com o numero da revisao dela:
#
#     Executable doesn't exist at /ms-playwright/chromium_headless_shell-1223/...
#
# O 1223 e a revisao que o playwright instalado pede; a imagem traz outra. Sem
# esta linha, todo caminho que abre navegador pelo Python falha — a etapa 6 e
# a busca da etapa 4 morreram exatamente assim.
RUN python -m playwright install chromium chromium-headless-shell

# ── NODE, E ELE FALTAVA ─────────────────────────────────────────────────────
#
# A etapa 1 da captura NAO e Python: `minerar_captura.py` chama
#
#     npx ts-node src/capture-cli.ts --sessao ... --poly ... --zoom ...
#
# e a imagem `playwright/python` NAO traz Node — so a `playwright/javascript`
# traz. O sintoma foi este, depois de a area ja ter sido carregada e a sessao
# criada, com a rodada morrendo no primeiro subprocesso:
#
#     FileNotFoundError: [Errno 2] No such file or directory: 'npx'
#
# `--no-install-recommends` e a limpeza do apt no mesmo RUN: sem isso a camada
# guarda a lista de pacotes do apt inteira, que nao serve para nada em execucao.
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# `npm ci` e nao `npm install`: ele obedece ao package-lock.json e falha se os
# dois discordarem, em vez de resolver versao sozinho. Numa imagem, resolver
# versao em tempo de build e o comeco de "funciona aqui e nao la".
#
# O `PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD` existe porque o pacote `playwright` do
# npm quer baixar OUTRA copia dos navegadores — a imagem ja traz os dela, na
# versao que casa com o Python, e a segunda copia so pesaria mais um giga.
COPY package.json package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --no-audit --no-fund

# O NAVEGADOR DO PLAYWRIGHT DO NPM, e ele nao e o mesmo do Python.
#
# A imagem traz os navegadores casados com o `playwright` do PIP (1.60.0). O
# `playwright` do NPM, que e quem a captura de tiles usa, resolveu para 1.59.1
# pelo package-lock — e cada versao procura o navegador na SUA pasta:
#
#     Executable doesn't exist at /ms-playwright/chromium_headless_shell-1217/...
#     current: mcr.microsoft.com/playwright/python:v1.60.0-jammy
#     required: mcr.microsoft.com/playwright/python:v1.59.1-jammy
#
# A mensagem sugere trocar a tag da imagem, e isso quebraria o lado Python.
# Alinhar as duas versoes seria o ideal, mas exige regerar o package-lock, que
# e decisao de quem mantem as dependencias JS.
#
# Instalar o navegador que o npm pede resolve sem tocar em nenhum dos dois: os
# dois conjuntos convivem em /ms-playwright, cada um na sua pasta versionada.
# So o `chromium` e o `chromium-headless-shell` — a captura nao usa Firefox nem
# WebKit, e cada um deles pesaria mais uns 300 MB a toa.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0 \
    npx playwright install chromium chromium-headless-shell

# `--chown` NO COPY, E NAO UM `chown -R` DEPOIS.
#
# ENUMERAR AS PASTAS QUE O PIPELINE ESCREVE E UMA APOSTA QUE JA PERDI DUAS
# VEZES NO MESMO DIA (04/09/2026). Primeiro faltou `/app/estado`, e a etapa 4
# morria depois de colher os placeIds. Corrigido isso, faltou
# `/app/dados_externos`, e a etapa 7 morria com o mesmo erro tres rodadas
# depois:
#
#     PermissionError: /app/dados_externos/ajuste_logradouro/4304606/entrada/pois.csv
#
# Contadas na imagem: 26 pastas sob `/app` que o processo nao podia escrever.
# Continuar listando uma a uma so adia a terceira descoberta.
#
# O DONO SAI DO COPY porque um `chown -R` num RUN duplicaria a arvore inteira
# numa camada nova — a imagem tem 32 GB. No COPY o custo e zero: o arquivo ja
# esta sendo escrito, so muda com que dono.
#
# O QUE SE PERDE: o processo passa a poder reescrever o proprio codigo. E um
# preco real, e foi pago de olhos abertos — a alternativa medida foi tres
# rodadas do cliente terminando com etapa faltando.
COPY --chown=pwuser:pwuser . .

# Usuário sem privilégio, como na API. A imagem do Playwright já traz `pwuser`
# justamente para isso — Chromium rodando como root desliga o sandbox dele, e aí
# uma página maliciosa deixa de ter uma barreira entre ela e o contêiner.
#
# `crops` e `capturas` são volume no compose: precisam sobreviver ao restart, e
# é o watcher da API que os lê para desenhar o mapa ao vivo.
#
# A LISTA DE PASTAS SAIU DAQUI, e o historico dela vale ser lembrado: era
# `/app/estado`, depois `/app` e o `.proxy_cache.json`, e ainda faltava
# `/app/dados_externos`. Ver o comentario do `COPY` acima — o dono agora vem
# de la, para a arvore inteira.
# Os pontos de montagem continuam aqui: VOLUME SOBREPOE O DONO DA IMAGEM, e
# um volume criado antes desta linha guarda a dona antiga. `radar-capturas` e
# `radar-crops` precisaram de `chown` a mao nas duas maquinas.
RUN mkdir -p /app/crops /app/capturas /app/logs /app/estado \
 && chown -R pwuser:pwuser /app/crops /app/capturas /app/logs /app/estado
USER pwuser

# NENHUM `EXPOSE`. Este contêiner não serve ninguém: ele consome a fila de jobs
# do banco e escreve resultado. Quem fala com o navegador é ele mesmo.

CMD ["python", "minerador_worker.py"]
