# O executor da validação de PRODUÇÃO no i9 (sem segredo: os segredos chegam pelo .env da cópia de produção).
# Só pega tarefas com ambiente = producao e roda o código da tag, em ~/producao/radarComercial.
VALIDACAO_AMBIENTE=producao
VALIDACAO_MAQUINA=i9
VALIDACAO_REPO=/home/a2l/producao/radarComercial
VALIDACAO_DADOS=/home/a2l/radar_validacao/producao
VALIDACAO_VAGAS=4
VALIDACAO_DB_HOST=192.168.3.10
VALIDACAO_ETAPAS=

# O POOLER VAI A 40 (18/09/2026): com 20, a validacao disputava conexao com a etapa 9, a frota e a API, e o
# julgamento esperava enquanto o i9 ficava parado. O Postgres aceita 100 e usava 46. O teto da validacao cabe
# um julgamento (4) mais o maximo das outras (foto 3, busca 2, cnpj 1, conferencia 2, storage 1) com folga.
VALIDACAO_POOL_TOTAL=40
VALIDACAO_TETO_CONEXOES=14
